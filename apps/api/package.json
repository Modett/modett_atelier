{
  "name": "@modett/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm --filter @modett/types run build && pnpm --filter @modett/db run build",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "migrate": "tsx ../../packages/db/src/migrate.ts",
    "type-check": "tsc --noEmit",
    "seed:user": "tsx scripts/seed-one-user.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1004.0",
    "@modett/db": "workspace:*",
    "@modett/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.36.4",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "multer": "^2.1.1",
    "pg": "^8.13.0",
    "resend": "^6.10.0",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/sharp": "^0.32.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}