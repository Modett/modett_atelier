# PAYable IPG (CDN SDK v3)
# PAYABLE_MERCHANT_KEY  = Merchant ID returned to frontend (public)
# PAYABLE_MERCHANT_TOKEN= Secret used only for SHA-512 checkValue (never sent to frontend)
PAYABLE_MERCHANT_KEY=400F6EF820842EAC
PAYABLE_MERCHANT_TOKEN=68C8BCB76B5BE19D7500D0286E2A51B1

FRONTEND_URL=https://hypercomposite-interneural-michelina.ngrok-free.dev
# Public API base (HTTPS) — used for PAYable notify_url when PAYABLE_WEBHOOK_URL is unset
API_URL=https://modettapi-production.up.railway.app
# Local API (uncomment for local-only dev; keep API_URL as Railway HTTPS for PAYable webhooks)
# API_URL=http://localhost:3001
# PAYable requires ALL URLs to be HTTPS — return_url, cancel_url, notify_url.
# For local dev you need HTTPS for the frontend too. Two options:
#   1. Use your Vercel preview URL:  FRONTEND_URL=https://your-app.vercel.app
#   2. Run a second ngrok tunnel:    npx ngrok http 3000
#      then set FRONTEND_URL=https://xxxx.ngrok-free.app
# Leave unset in production — Railway and Vercel both provide HTTPS by default.
PAYABLE_LOGO_URL=https://payableipgpublicdata.s3.ap-southeast-1.amazonaws.com/ipg_merchant_logo/Modett_Atelier_Logo.png
# Full notify_url for PAYable (must match what you configure in the PAYable merchant portal if required)
PAYABLE_WEBHOOK_URL=https://modettapi-production.up.railway.app/api/payments/webhook

