# =============================================================================
# Modett API — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# Database & Cache
DATABASE_URL=postgresql://postgres:password@localhost:5433/modett_db
REDIS_URL=redis://localhost:6379

# Server
PORT=3001
NODE_ENV=development

# Swagger (disable in production)
SWAGGER_ENABLED=1

# =============================================================================
# PAYable IPG (CDN SDK v3)
#
# Credentials — obtain from PAYable support (sandbox and production are separate):
#   PAYABLE_MERCHANT_KEY   = Merchant ID (public — returned to frontend as part of SDK params)
#   PAYABLE_MERCHANT_TOKEN = Secret token (NEVER returned to frontend; used only for SHA-512)
#
# checkValue is generated server-side:
#   UPPERCASE(SHA512[merchantKey | invoiceId | amount | currencyCode | UPPERCASE(SHA512[merchantToken])])
#
# Frontend loads PAYable SDK via CDN <Script> tag and calls window.payable.startPayment(params).
# PAYable ONLY accepts LKR currency — SGD/USD orders are converted to LKR server-side.
# =============================================================================
PAYABLE_MERCHANT_KEY=your_merchant_key_here
PAYABLE_MERCHANT_TOKEN=your_merchant_token_here

# URLs
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# PAYable requires HTTPS for webhookUrl and returnUrl.
# In local dev, expose your API with ngrok and set PAYABLE_WEBHOOK_URL:
#   ngrok http 3001
#   PAYABLE_WEBHOOK_URL=https://xxxx.ngrok-free.app/api/payments/webhook
# In production (Railway HTTPS) leave this unset — API_URL is used automatically.
# PAYABLE_WEBHOOK_URL=

# Logo shown on PAYable payment page (optional)
PAYABLE_LOGO_URL=https://yourdomain.com/logo.png

# =============================================================================
# Cloudflare R2 Storage
# =============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=modett-media
R2_PUBLIC_URL=
