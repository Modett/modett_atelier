# ============================================================
# Modett API — Environment Variables
# Copy this to .env for local development.
# Set these in Railway dashboard for production.
# ============================================================

# Server
NODE_ENV=development
PORT=3001

# Database (Railway PostgreSQL — auto-injected by Railway as DATABASE_URL)
DATABASE_URL=postgresql://user:password@localhost:5432/modett

# Redis (Railway Redis — auto-injected as REDIS_URL)
REDIS_URL=redis://localhost:6379

# Frontend URL (Vercel deployment URL)
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_WWW=

# API URL (Railway deployment URL, e.g. https://your-service.up.railway.app)
# Used as base for PAYable notify_url when PAYABLE_WEBHOOK_URL is not set:
#   notify_url = API_URL + /api/payments/webhook
API_URL=http://localhost:3001

# PAYable Payment Gateway
PAYABLE_MERCHANT_KEY=your_merchant_key_here
PAYABLE_MERCHANT_TOKEN=your_merchant_token_here

# Optional: full PAYable notify_url (webhook). Overrides API_URL-derived default.
# Example: https://your-service.up.railway.app/api/payments/webhook
PAYABLE_WEBHOOK_URL=

# Session / Cookie secret
SESSION_SECRET=change_this_to_a_long_random_string_in_production

# Resend — https://resend.com/api-keys — key must start with re_
RESEND_API_KEY=
# Contact form + default from for SDK sends (address only; display name is "Modett")
EMAIL_FROM=noreply@modett.com
# Inbox for contact form notifications
EMAIL_CONTACT_INBOX=hello@modett.com
# Password reset (optional): full From string, e.g. Modett <onboarding@resend.dev>
RESEND_FROM=

# Cloudflare R2 (image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
