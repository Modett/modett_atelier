# ============================================================
# Modett Web — Environment Variables (apps/web)
# Copy this to .env.local for local development.
# Configure these in the Vercel project settings for production.
# ============================================================
#
# apps/web NEVER connects to the database or Redis directly.
# Do NOT add DATABASE_URL or REDIS_URL here or in Vercel. Modett rule 2.3.

# Railway API base — apps/web makes all API calls against this origin.
# Must point to your sandbox API while testing PAYable sandbox.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public site URL (used for canonical/OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default country/currency for first visit before geo-IP middleware sets a cookie.
NEXT_PUBLIC_DEFAULT_COUNTRY=LK
NEXT_PUBLIC_DEFAULT_CURRENCY=LKR

# ------------------------------------------------------------
# PAYable IPG SDK
# ------------------------------------------------------------
# The checkout layout (apps/web/src/app/checkout/layout.tsx) automatically
# picks sandbox or live SDK based on NODE_ENV:
#   sandbox: https://sandboxipgsdk.payable.lk/sdk/v3/payable-checkout.js
#   live:    https://ipgsdk.payable.lk/sdk/v3/payable-checkout.js
# There is no client-side PAYable secret — all checkValue generation and
# OAuth happen server-side (apps/api). Only NEXT_PUBLIC_API_URL is needed here.
