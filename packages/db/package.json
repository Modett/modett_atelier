{
  "name": "@modett/db",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "migrate": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:dummy": "tsx src/seeds/dummy.ts",
    "seed:reset": "tsx src/seeds/dummy.ts"
  },
  "dependencies": {
    "@modett/types": "workspace:*",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.36.0",
    "ioredis": "^5.9.3",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
